# SPDX-License-Identifier: MIT
"""One-time password creation; stdin only, fixed account, no shell."""
import os
from pathlib import Path
import subprocess
import sys

STATE = Path('/var/lib/omarchy-ppp/provisioned')


def validate(password):
    if not 8 <= len(password) <= 256 or any(c in password for c in '\n\r\0'):
        raise ValueError('Use 8–256 characters, without line breaks.')
    return password


def main():
    if os.geteuid() != 0 or os.environ.get('SUDO_USER') != 'terminal' or STATE.exists():
        raise SystemExit('First-boot password setup is unavailable.')
    password = validate(sys.stdin.read(1025))
    subprocess.run(['/usr/bin/chpasswd'], input='terminal:' + password + '\n', text=True, check=True)
    Path('/etc/sddm.conf.d/95-omarchy-ppp-firstboot.conf').unlink(missing_ok=True)
    Path('/etc/sudoers.d/omarchy-ppp-firstboot').unlink(missing_ok=True)
    STATE.parent.mkdir(mode=0o755, exist_ok=True)
    STATE.touch(mode=0o600)


if __name__ == '__main__':
    main()
